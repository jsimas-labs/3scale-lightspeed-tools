# Build stage
FROM docker.io/library/golang:1.25 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/3scale-troubleshoot-mcp .

# Runtime stage
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
LABEL name="3scale-troubleshoot-mcp" \
      summary="MCP server with read-only troubleshooting tools for Red Hat 3scale API Management" \
      description="Model Context Protocol server consumed by OpenShift Lightspeed to diagnose 3scale API Manager installations" \
      io.k8s.display-name="3scale Troubleshoot MCP Server"
COPY --from=builder /out/3scale-troubleshoot-mcp /usr/local/bin/3scale-troubleshoot-mcp
USER 1001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/3scale-troubleshoot-mcp"]
CMD ["-transport", "http", "-listen", ":8080"]
